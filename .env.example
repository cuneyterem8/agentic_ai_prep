# Kopyala: copy .env.example .env
# OPENAI_API_KEY — gerçek anahtarınızı sadece .env dosyasına yazın (.env git'e eklenmez)

# LLM Provider
OPENAI_API_KEY=
LLM_PROVIDER=mock
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# App
LOG_LEVEL=INFO
APP_ENV=development
APP_VERSION=0.1.0
PROMPT_VERSION=v1
LLM_PROMPT_COST_PER_1K_USD=0.005
LLM_COMPLETION_COST_PER_1K_USD=0.015

# Database (local: SQLite)
DATABASE_URL=sqlite:///./data/app.db

# Deploy — docker-compose.deploy.yml (staging)
POSTGRES_USER=agenticai
POSTGRES_PASSWORD=agenticai
POSTGRES_DB=agenticai
POSTGRES_PORT=5432
API_PORT=8000
